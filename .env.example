# ── LLM Provider (Groq only) ─────────────────────────────────────────────────
# Groq API key — required. Set this to use the LLM.
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=
# Groq model — auto-selected if empty (uses internal default: openai/gpt-oss-20b)
GROQ_MODEL=

# ── Loop Configuration ────────────────────────────────────────────────────────
# Number of iterations in the agentic loop (default: 5)
MAX_ITERATIONS=5
# Number of examples per iteration (default: 200)
NUM_EXAMPLES=200
# Wall-clock cap in seconds (default: 600)
WALL_CLOCK_CAP=600
# Cost budget in USD (default: 5.0)
COST_BUDGET=5.0