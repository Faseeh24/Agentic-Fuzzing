# ── LLM Provider (Groq only) ─────────────────────────────────────────────────
# Groq API key — required. Set this to use the LLM.
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=
# Groq model — auto-selected if empty (uses internal default: llama-3.3-70b-versatile)
GROQ_MODEL=

# ── Loop Configuration ────────────────────────────────────────────────────────
# Number of iterations in the agentic loop (default: 5)
MAX_ITERATIONS=5
# Number of examples per iteration (default: 200)
NUM_EXAMPLES=200
# Max total examples across all iterations (default: 1000)
MAX_TOTAL_EXAMPLES=1000
# Wall-clock cap in seconds (default: 600)
WALL_CLOCK_CAP=600
# Cost budget in USD (default: 5.0)
COST_BUDGET=5.0

# ── Hypothesis Settings ───────────────────────────────────────────────────────
# Max examples Hypothesis generates per strategy run
HYPOTHESIS_MAX_EXAMPLES=200
# Report all failures during Hypothesis runs
HYPOTHESIS_REPORT_ALL_FAILURES=true
# Hypothesis deadline per example in ms (None = disabled)
HYPOTHESIS_DEADLINE=5000

# ── Harness Settings ──────────────────────────────────────────────────────────
# Timeout per input in seconds
HARNESS_TIMEOUT=5
# Enable persistent fuzzing mode (reuse process, no new subprocess per input)
PERSISTENT_MODE=false

# ── Coverage Settings ─────────────────────────────────────────────────────────
# Enable coverage-guided fuzzing (requires llvm-cov installed)
COVERAGE_ENABLED=true
# Coverage output format: text, lcov, html
COVERAGE_FORMAT=text
# Coverage directory
COVERAGE_DIR=/tmp/mxml-coverage

# ── Sandbox Settings ──────────────────────────────────────────────────────────
# Enable sandboxed execution (Docker)
SANDBOX_ENABLED=true
# Sandbox image name
SANDBOX_IMAGE=mxml-fuzz-sandbox
