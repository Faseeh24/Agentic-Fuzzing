# ── API Keys ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Only the providers you have keys for will be used; the client auto-fallbacks.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Optional: Hypothesis settings ─────────────────────────────────────────────
# HYPOTHESIS_MAX_EXAMPLES=200
# HYPOTHESIS_REPORT_ALL_FAILURES=true
